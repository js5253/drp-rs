{
  "browser_action": {
    "default_title": "drp.rs web media extension",
    "default_popup": "tabs.html"
  },
  "description": "Helper extension for drp.rs",
  "homepage_url": "https://github.com/js5253/drp-rs",
  "manifest_version": 2,
  "name": "drp.rs web media extension",

  "permissions": ["tabs", "activeTab", "scripting"],
  "background": {
    "scripts": ["background.js"]
